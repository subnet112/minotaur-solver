@@ -928,6 +994,25 @@
                 [(_ck(tin), _ck(tout), int(cand["param"]), _ck(recipient), int(deadline), int(amount_in), 0, 0)])
             call = "0x" + ("414bf389" + enc.hex())
             route_tag = "pancake_v3"
+        elif cand["venue"] == "curve_base":
+            # curve-base edge: execute via the Curve router-NG exchange(), using
+            # the exact route arrays we quoted get_dy with. min_dy=0 (the harness
+            # enforces the order min at the intent level; the quoter already
+            # verified out>0/>=min before this venue could be selected).
+            from eth_abi import encode as _abi_encode
+            from eth_utils import keccak as _keccak, to_checksum_address as _ck
+            router = _BASE_CURVE_ROUTER
+            route = list(cand["curve_route"])
+            swap_params = [list(row) for row in cand["curve_swap_params"]]
+            pools = list(cand["curve_pools"])
+            selector = _keccak(
+                text="exchange(address[11],uint256[5][5],uint256,uint256,address[5],address)"
+            )[:4]
+            call = "0x" + (selector + _abi_encode(
+                ["address[11]", "uint256[5][5]", "uint256", "uint256", "address[5]", "address"],
+                [route, swap_params, int(amount_in), 0, pools, _ck(recipient)],
+            )).hex()
+            route_tag = "curve_base"
